{
  "name": "civiq-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/seed/index.js",
    "migrate:conflict-pairkey": "node src/scripts/backfillConflictPairKeys.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "node --check server.js",
    "test": "node --import ./test/setup.js --test \"test/**/*.test.js\"",
    "test:coverage": "node --import ./test/setup.js --test --experimental-test-coverage \"test/**/*.test.js\"",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "morgan": "^1.11.0",
    "redis": "^6.2.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "nodemon": "^3.0.2"
  }
}
