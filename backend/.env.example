# =====================================
# Server
# =====================================
PORT=5000
NODE_ENV=development

# =====================================
# Database
# =====================================
# Required. WARNING: `npm run seed` DELETES every notification, audit log,
# conflict, complaint, project, user and department in whichever database this
# points at — all seven collections — before inserting its fixtures.
MONGODB_URI=

# =====================================
# Authentication
# =====================================
# JWT_SECRET signs both session tokens and the short-lived SSE stream tickets.
# Use a long random value; changing it invalidates every issued token.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# =====================================
# Frontend
# =====================================
CLIENT_URL=http://localhost:5173

# =====================================
# Reverse proxy — optional
# =====================================
# Set to the proxy hop count (e.g. 1 for Nginx, 2 for CDN + Nginx).
TRUST_PROXY=

# =====================================
# Mail (Brevo) — optional
# =====================================
# Leave BREVO_API_KEY empty to run without email. Notifications are still
# stored and delivered in-app; email delivery is marked "skipped" rather than
# failing. Sent through the Brevo REST API — no SMTP settings are used.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CiViQ
# Optional: enables cross-instance notification fan-out.
# Omit for a single-instance deployment; the stream stays process-local.
REDIS_URL=redis://127.0.0.1:6379
